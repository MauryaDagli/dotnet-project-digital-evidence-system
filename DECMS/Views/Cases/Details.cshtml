@model DECMS.Models.Case
@{
    ViewData["Title"] = "Case Details";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Cases</a>
    @if(User.IsInRole("Admin") || User.IsInRole("Police Officer") || User.IsInRole("Investigator") || User.IsInRole("ADMIN") || User.IsInRole("POLICE OFFICER") || User.IsInRole("INVESTIGATOR"))
    {
        <a href="/Evidences/Create?caseId=@Model.Id" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Register Evidence</a>
    }
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Case Info</h5>
            </div>
            <div class="card-body">
                <h3 class="fw-bold">@Model.CaseNumber</h3>
                <p class="text-muted">@Model.Title</p>
                <hr />
                <dl class="row mb-0">
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if(Model.Status == "Open") { <span class="badge bg-success">@Model.Status</span> }
                        else { <span class="badge bg-secondary">@Model.Status</span> }
                    </dd>

                    <dt class="col-sm-4">Priority</dt>
                    <dd class="col-sm-8">@Model.Priority</dd>

                    <dt class="col-sm-4">Incident</dt>
                    <dd class="col-sm-8">@Model.IncidentDate.ToString("d")</dd>

                    <dt class="col-sm-4">Location</dt>
                    <dd class="col-sm-8">@Model.Location</dd>

                    <dt class="col-sm-4">Assigned</dt>
                    <dd class="col-sm-8">@(Model.AssignedOfficer?.FullName ?? "N/A")</dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("g")<br/><small class="text-muted">by @(Model.CreatedBy?.FullName)</small></dd>
                </dl>
            </div>
        </div>
        
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h5 class="mb-0">Description</h5>
            </div>
            <div class="card-body">
                <p class="mb-0">@Model.Description</p>
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0"><i class="bi bi-box-seam text-primary"></i> Registered Evidence (@Model.Evidences.Count)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Evidence ID</th>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in Model.Evidences) {
                                <tr>
                                    <td class="fw-bold">@ev.EvidenceNumber</td>
                                    <td>@ev.Name</td>
                                    <td>@ev.Type</td>
                                    <td><span class="badge bg-info text-dark">@ev.Status</span></td>
                                    <td>
                                        <a href="/Evidences/Details/@ev.Id" class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            }
                            @if(!Model.Evidences.Any()) {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No evidence registered for this case yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

