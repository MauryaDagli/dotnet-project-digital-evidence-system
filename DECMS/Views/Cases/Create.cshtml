@model DECMS.Models.Case
@{
    ViewData["Title"] = "Create Case";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Cases</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h4 class="mb-0"><i class="bi bi-journal-plus text-primary"></i> Register New Case</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CaseNumber" class="form-label fw-bold">Case Number</label>
                    <input asp-for="CaseNumber" class="form-control" placeholder="e.g. CASE-2026-0001" />
                    <span asp-validation-for="CaseNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Case Title</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Status" class="form-label fw-bold">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Open">Open</option>
                        <option value="Under Investigation">Under Investigation</option>
                        <option value="Closed">Closed</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Priority" class="form-label fw-bold">Priority</label>
                    <select asp-for="Priority" class="form-select">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                    <span asp-validation-for="Priority" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="IncidentDate" class="form-label fw-bold">Incident Date</label>
                    <input asp-for="IncidentDate" class="form-control" type="date" />
                    <span asp-validation-for="IncidentDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Location" class="form-label fw-bold">Location</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="AssignedOfficerId" class="form-label fw-bold">Assign To</label>
                    <select asp-for="AssignedOfficerId" class="form-select" asp-items="ViewBag.AssignedOfficerId">
                        <option value="">-- Select Personnel --</option>
                    </select>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Case</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
